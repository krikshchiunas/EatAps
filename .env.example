# Скопируйте в .env.local и вставьте значения из Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Серверные ключи. В .env.local нужны только для локального `vercel dev`;
# на проде задаются в переменных окружения Vercel.
#
# Префикса VITE_ здесь быть НЕ ДОЛЖНО: всё с ним Vite вшивает в клиентский
# бандл, и ключ утечёт первому, кто откроет DevTools.
# ─────────────────────────────────────────────────────────────────────────────

# AI-ассистент (api/ai/*)
ANTHROPIC_API_KEY=

# Доступ к базе с сервера — для учёта расхода токенов и чтения тарифа
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Подписки (api/stripe/*)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_AI=
STRIPE_PRICE_AI_PLUS=

# Телеграм-бот модерации (api/telegram/*)
# TG_TOKEN — у @BotFather. TG_WEBHOOK_SECRET вы придумываете сами: это общий
# пароль между вашим сервером и Телеграмом, им отсекается чужой POST на
# публичный адрес вебхука. Проще всего — bash scripts/setup-telegram.sh
TG_TOKEN=
TG_WEBHOOK_SECRET=
TG_ADMIN_CHAT_IDS=
