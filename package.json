{
  "name": "eataps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inject-precache.mjs",
    "preview": "vite preview",
    "test": "node --test src/lib/*.test.js api/*.test.js api/stripe/*.test.js api/telegram/*.test.js api/ai/*.test.js",
    "sql:build": "node scripts/build-setup-all.mjs",
    "sql:catalog": "node scripts/sql-catalog.mjs",
    "sql:check": "node scripts/check-sql.mjs",
    "sql:policies": "node scripts/policy-audit.mjs",
    "sql:idem": "node scripts/sql-idempotency.mjs",
    "sql:verify": "node scripts/build-setup-all.mjs --check && node scripts/sql-catalog.mjs --check && node scripts/sql-idempotency.mjs && node scripts/check-sql.mjs",
    "lint": "eslint .",
    "verify": "npm run lint && npm test && npm run sql:verify && npm run build"
  },
  "dependencies": {
    "@reown/appkit": "^1.8.23",
    "@reown/appkit-adapter-ethers": "^1.8.23",
    "@reown/appkit-adapter-solana": "^1.8.23",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.111.0",
    "ethers": "^6.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
